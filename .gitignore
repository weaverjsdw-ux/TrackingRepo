# --- PII/PHI: NEVER commit real subscriber/lead-scoring data (BRIEF §0) ---
# The real example folder lives OUTSIDE this repo (../ "Bradley University ...").
# These patterns are belt-and-suspenders in case real files are ever copied in.
real_data/
**/real/
*export_*.csv
Job_*_Overview_*.pdf
sd_*.csv
# Real finished-file naming convention "<Client> <Season> <Year> <Type> - *.csv"
* eNL - *.csv
* ePC - *.csv
* - Engagement Tracking Report.pdf

# ...but DO commit the synthetic (no-PII) fixtures, which deliberately reuse the
# raw export_/sd_ naming so they exercise the same code paths.
!tests/fixtures/synthetic/**

# Local intake working dirs (real attachments = PII) — never commit.
drop/
**/drop/
contacts.csv
.automation_state.json
# Per-run logs (may contain client names/counts).
logs/

# Secrets / credentials (Gmail, Sheets service account) — never committed.
.env
*.env
!.env.example
credentials*.json
token*.json
service-account*.json
client_secret*.json

# eQC metric CSVs (belt-and-suspenders, like the eNL/ePC lines above).
* eQC - *.csv

# Per-run manifests hold PII (client names, SendIDs, counts, draft IDs) —
# never commit real runs; keep only the redacted example.
runs/*
!runs/example/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.venv/
venv/
*.egg-info/
build/
dist/
