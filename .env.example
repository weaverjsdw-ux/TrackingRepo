# Copy to .env (git-ignored) and fill in. NEVER commit real secrets (BRIEF §0).

# --- Phase 2: Gmail intake ---
# The dedicated label the operator applies to report emails (BRIEF §1).
GMAIL_LABEL=tracking-reports

# Auth: path to the OAuth client secret (personal/Workspace user consent) OR the
# service-account key (Workspace domain-wide delegation). Exactly one is used,
# depending on the auth mode chosen with the operator (open question).
GOOGLE_OAUTH_CLIENT_SECRET=secrets/client_secret.json
GOOGLE_TOKEN_PATH=secrets/token.json
# GOOGLE_SERVICE_ACCOUNT=secrets/service-account.json
# GMAIL_DELEGATED_USER=reports@yourdomain.org

# Where staged sends are written (internal handoff to the Phase 1 pipeline).
DROP_ROOT=./drop

# --- Phase 3 (later): Google Sheet write-back ---
# SHEET_ID=1oi851C2NUoCLELTw80-tmEL7ztyHM_u-KQDubKM1tnY
# GOOGLE_SHEETS_SERVICE_ACCOUNT=secrets/service-account.json
