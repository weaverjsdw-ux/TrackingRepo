# Copy to .env (git-ignored) and fill in. NEVER commit real secrets (BRIEF §0).

# --- Phase 2: Gmail intake ---
# The dedicated label the operator applies to report emails (BRIEF §1).
GMAIL_LABEL=tracking-reports

# Auth: path to the OAuth client secret (personal/Workspace user consent) OR the
# service-account key (Workspace domain-wide delegation). Exactly one is used,
# depending on the auth mode chosen with the operator (open question).
GOOGLE_OAUTH_CLIENT_SECRET=secrets/client_secret.json
GOOGLE_TOKEN_PATH=secrets/token.json
# GOOGLE_SERVICE_ACCOUNT=secrets/service-account.json
# GMAIL_DELEGATED_USER=reports@yourdomain.org

# Where staged sends are written (internal handoff to the Phase 1 pipeline).
DROP_ROOT=./drop
# Where the renamed report folders are filed (default: parent of this project).
REPORTS_DIR=../
# Local contact routing source for Gmail draft creation. Copy
# contacts.example.csv to contacts.csv and fill in real client/PC addresses.
CONTACTS_CSV=contacts.csv
# Optional scheduler log cap in bytes before logs/run.log rotates to run.log.1.
TRACKING_RUN_LOG_MAX_BYTES=2097152

# --- Phase 3 (later): Google Sheet write-back ---
# SHEET_ID=1oi851C2NUoCLELTw80-tmEL7ztyHM_u-KQDubKM1tnY
# GOOGLE_SHEETS_SERVICE_ACCOUNT=secrets/service-account.json

# --- SFMC/ExactTarget API probe ---
# Required for `python -m tracking.cli sfmc-probe --send-id <id>`.
# SFMC_AUTH_BASE_URL=https://YOURSUBDOMAIN.auth.marketingcloudapis.com
# SFMC_REST_BASE_URL=https://YOURSUBDOMAIN.rest.marketingcloudapis.com
# SFMC_CLIENT_ID=
# SFMC_CLIENT_SECRET=
# SFMC_ACCOUNT_ID=
#
# Optional capability endpoints. Configure only if your SFMC package exposes
# these send/tracking/artifact routes; otherwise the probe will block honestly.
# SFMC_SEND_LOOKUP_URL=
# SFMC_OVERVIEW_PDF_URL=
# SFMC_TRACKING_SENT_URL=
# SFMC_TRACKING_OPEN_URL=
# SFMC_TRACKING_CLICK_URL=
# SFMC_TRACKING_BOUNCE_URL=
# SFMC_TRACKING_UNSUB_URL=
#
# Required for `python -m tracking.cli sfmc-stage ...` after the probe passes.
# These should return raw CSV/PDF bytes; filenames are assigned locally because
# the parser identifies files by content, not download names.
# SFMC_ARTIFACT_SENT_URL=
# SFMC_ARTIFACT_OPEN_URL=
# SFMC_ARTIFACT_CLICK_URL=
# SFMC_ARTIFACT_BOUNCE_URL=
# SFMC_ARTIFACT_UNSUB_URL=
# SFMC_ARTIFACT_OVERVIEW_PDF_URL=
# Optional request/booklet click export if available; otherwise BH can fall
# back to the master click export where unambiguous.
# SFMC_ARTIFACT_BOOKLET_URL=
