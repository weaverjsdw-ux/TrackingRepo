# Copy to .env (git-ignored) and fill in. NEVER commit real secrets.
#
# Legend:  [SHARED] = get this from the primary operator (secure hand-off)
#          [YOURS]  = specific to your machine / your identity
# Second operator? Follow docs/COWORKER_ONBOARDING.md — it explains each value.

# ─────────────────────────────────────────────────────────────────────────
# LIVE CONFIG — required for pull_reports.py (direct SFMC) and cli intake
# ─────────────────────────────────────────────────────────────────────────

# --- SFMC / ExactTarget API ---  [SHARED]
SFMC_AUTH_BASE_URL=https://<subdomain>.auth.marketingcloudapis.com/
SFMC_REST_BASE_URL=https://<subdomain>.rest.marketingcloudapis.com/
SFMC_SOAP_BASE_URL=https://<subdomain>.soap.marketingcloudapis.com/
SFMC_CLIENT_ID=
SFMC_CLIENT_SECRET=
# SFMC_ACCOUNT_ID=          # optional MID; set only if your package requires it

# --- Google Sheets: Print Status Report + calendar ---  [SHARED]
SHEET_ID=1oi851C2NUoCLELTw80-tmEL7ztyHM_u-KQDubKM1tnY
SHEET_TAB=2026 Print Status Report
CALENDAR_ID=1eTZXc9bNaRbMWmFeJPPc56LCmbO42egvkJy1Sjo89is
GOOGLE_SHEETS_SERVICE_ACCOUNT=secrets/service-account.json

# --- Gmail (drafts on the direct path; intake on Path 2) ---
GOOGLE_OAUTH_CLIENT_SECRET=secrets/client_secret.json   # [SHARED] app client file
GOOGLE_TOKEN_PATH=secrets/token.json                    # [YOURS]  minted by `cli authorize`
GMAIL_LABEL=tracking-reports                            # intake queue label in your inbox

# --- Per-operator ---  [YOURS]
# Where renamed report folders are filed. Absolute path recommended.
REPORTS_DIR=../
# YOUR initials on the calendar mark (e.g. "7/24 AB"). Defaults to JS if unset —
# a second operator MUST set this so marks aren't stamped with someone else's initials.
# CALENDAR_MARK_INITIALS=AB
# Lead Scoring CSV output (defaults to <REPORTS_DIR>/Lead Scoring).
# LEAD_SCORING_DIR=../Lead Scoring

# --- Local / intake defaults (usually leave as-is) ---
DROP_ROOT=./drop
CONTACTS_CSV=contacts.csv
# Scheduler log cap (bytes) before logs/run.log rotates to run.log.1.
TRACKING_RUN_LOG_MAX_BYTES=2097152

# ─────────────────────────────────────────────────────────────────────────
# LEGACY — SFMC probe/stage endpoints (`sfmc-probe` / `sfmc-stage`).
# Superseded by pull_reports.py; configure ONLY if you still use those older
# commands. The manifest-driven pull_reports.py path does not need these.
# ─────────────────────────────────────────────────────────────────────────
# SFMC_SEND_LOOKUP_URL=
# SFMC_OVERVIEW_PDF_URL=
# SFMC_TRACKING_SENT_URL=
# SFMC_TRACKING_OPEN_URL=
# SFMC_TRACKING_CLICK_URL=
# SFMC_TRACKING_BOUNCE_URL=
# SFMC_TRACKING_UNSUB_URL=
# SFMC_ARTIFACT_SENT_URL=
# SFMC_ARTIFACT_OPEN_URL=
# SFMC_ARTIFACT_CLICK_URL=
# SFMC_ARTIFACT_BOUNCE_URL=
# SFMC_ARTIFACT_UNSUB_URL=
# SFMC_ARTIFACT_OVERVIEW_PDF_URL=
# SFMC_ARTIFACT_BOOKLET_URL=
